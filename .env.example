# Environment variables example for HopeNest Backend (Render Deployment)
# Copy this file to .env for local testing (Do NOT commit real .env to GitHub!)

# Django Secret Key (generate a secure random 50+ char string in production)
SECRET_KEY=your-production-secret-key-change-me

# Debug Mode (MUST be False in production)
DEBUG=False

# Database URL provided by Render PostgreSQL service
# Format: postgresql://username:password@host:5432/database_name
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Allowed Hosts (comma-separated domains)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# CORS Allowed Origins for React Frontend (comma-separated URLs)
CORS_ALLOWED_ORIGINS=https://your-frontend-app.onrender.com,http://localhost:5173

# CSRF Trusted Origins (comma-separated URLs)
CSRF_TRUSTED_ORIGINS=https://your-frontend-app.onrender.com,https://your-backend-app.onrender.com

# Optional SSL & Cookie Security Settings
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Razorpay Payment Gateway Configuration (Test Mode keys start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
